    @staticmethod
    def _post_length(text: str) -> int:
        """Longueur pondérée façon X : caractères latins = 1, autres (emoji, CJK…) = 2. URLs non comptées à 23."""
        latin = ((0, 4351), (8192, 8205), (8208, 8223), (8242, 8247))
        return sum(1 if any(a <= ord(c) <= b for a, b in latin) else 2 for c in text)

    def _post_failure_notice(self, result: Dict[str, Any]) -> None:
        if not result.get("ok") and result.get("status_code") in (401, 403):
            result["notice"] = (
                "Publier ou supprimer un post exige un contexte utilisateur : soit les 4 clés "
                "OAuth 1.0a dans les Valves (X_API_KEY, X_API_SECRET, X_OAUTH1_ACCESS_TOKEN, "
                "X_OAUTH1_ACCESS_SECRET), soit un token OAuth 2.0 user-context (tweet.read, "
                "tweet.write, users.read) dans X_ACCESS_TOKEN. Un token app-only ne peut pas publier. "
                f"Mode utilisé : {'OAuth 1.0a' if self._oauth1_configured() else 'Bearer'}."
            )

    def create_post(
        self,
        text: str,
        reply_to_post_id: Optional[str] = None,
        quote_post_id: Optional[str] = None,
        media_ids: Optional[str] = None,
        confirm: bool = False,
    ) -> str:
        """
        Publie un post sur X (POST /2/tweets). Action publique et visible : sans confirm=true,
        renvoie seulement un aperçu (longueur, corps de la requête) et ne publie rien.
        :param text: Texte du post.
        :param reply_to_post_id: ID d'un Post auquel répondre (optionnel).
        :param quote_post_id: ID d'un Post à citer (optionnel).
        :param media_ids: IDs de médias déjà téléversés avec upload_media (champ media_id de sa réponse), séparés par des virgules (optionnel).
        :param confirm: Mettre true pour publier réellement.
        """
        text = (text or "").strip()
        ids = [m.strip() for m in (media_ids or "").split(",") if m.strip()]
        if not text and not ids:
            return self._dump(
                {"ok": False, "error": "Fournissez un texte ou des media_ids."}
            )

        length = self._post_length(text)
        limit = int(self.valves.MAX_POST_LENGTH)
        if length > limit:
            return self._dump(
                {
                    "ok": False,
                    "error": f"Post trop long : {length} caractères pondérés pour {limit} autorisés.",
                }
            )
        for label, value in (
            ("reply_to_post_id", reply_to_post_id),
            ("quote_post_id", quote_post_id),
        ):
            if value and not value.strip().isdigit():
                return self._dump(
                    {
                        "ok": False,
                        "error": f"{label} doit être un identifiant numérique.",
                    }
                )
        if ids and not all(i.isdigit() for i in ids):
            return self._dump(
                {
                    "ok": False,
                    "error": "media_ids doit contenir des identifiants numériques.",
                }
            )
        if len(ids) > 4:
            return self._dump({"ok": False, "error": "4 médias maximum par post."})

        body: Dict[str, Any] = {}
        if text:
            body["text"] = text
        if reply_to_post_id:
            body["reply"] = {"in_reply_to_tweet_id": reply_to_post_id.strip()}
        if quote_post_id:
            body["quote_tweet_id"] = quote_post_id.strip()
        if ids:
            body["media"] = {"media_ids": ids}

        if not confirm:
            return self._dump(
                {
                    "ok": True,
                    "preview": True,
                    "weighted_length": f"{length}/{limit} (hors URLs, comptées 23 par X)",
                    "request_body": body,
                    "message": "Aperçu seulement. Relancez avec confirm=true pour publier.",
                }
            )

        result = self._call(
            "POST",
            "",
            json_body=body,
            base=self.valves.X_POSTS_BASE.strip().rstrip("/"),
            auth=self._post_auth_mode(),
        )
        if result.get("ok"):
            data = result.get("data")
            post_id = (
                data.get("data", {}).get("id")
                if isinstance(data, dict) and isinstance(data.get("data"), dict)
                else None
            )
            if post_id:
                result["url"] = f"https://x.com/i/status/{post_id}"
        self._post_failure_notice(result)
        return self._dump(result)

    def delete_post(self, post_id: str, confirm: bool = False) -> str:
        """
        Supprime un de vos posts (DELETE /2/tweets/:id). Sans confirm=true, renvoie seulement un aperçu.
        :param post_id: ID numérique du Post à supprimer.
        :param confirm: Mettre true pour supprimer réellement.
        """
        post_id = (post_id or "").strip()
        if not post_id.isdigit():
            return self._dump(
                {"ok": False, "error": "post_id doit être un identifiant numérique."}
            )
        if not confirm:
            return self._dump(
                {
                    "ok": True,
                    "preview": True,
                    "message": f"Le post {post_id} serait supprimé. Relancez avec confirm=true pour confirmer.",
                }
            )
        result = self._call(
            "DELETE",
            f"/{post_id}",
            base=self.valves.X_POSTS_BASE.strip().rstrip("/"),
            auth=self._post_auth_mode(),
        )
        self._post_failure_notice(result)
        return self._dump(result)

    def verify_credentials(self) -> str:
        """
        Vérifie les identifiants de publication sans rien publier : renvoie le compte X (@handle)
        associé aux clés, et le mode d'authentification utilisé (OAuth 1.0a ou Bearer).
        À lancer avant le premier post pour confirmer que les clés sont bien celles de @hq_wire.
        """
        mode = self._post_auth_mode()
        result = self._call("GET", "", base=self.USERS_ME_URL, auth=mode)
        result["auth_mode"] = (
            "OAuth 1.0a" if mode == "oauth1" else "Bearer (X_ACCESS_TOKEN)"
        )
        data = result.get("data")
        user = data.get("data") if isinstance(data, dict) else None
        if result.get("ok") and isinstance(user, dict) and user.get("username"):
            result["account"] = f"@{user['username']}"
        elif not result.get("ok"):
            result["notice"] = (
                "Échec de la vérification. Si le statut est 401 : clés incorrectes ou mal copiées. "
                "Si 403 : app non autorisée, ou token app-only (incapable de publier)."
            )
        return self._dump(result)

