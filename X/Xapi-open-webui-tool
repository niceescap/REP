    def __init__(self):
        self.valves = self.Valves()

    # ------------------------------------------------------------------
    # Helpers privés
    # ------------------------------------------------------------------
    @staticmethod
    def _dump(obj: Any) -> str:
        return json.dumps(obj, ensure_ascii=False, indent=2)

    def _base_url(self) -> str:
        return (self.valves.X_API_BASE.strip() or self.DEFAULT_BASE).rstrip("/")

    def _media_base(self) -> str:
        return (self.valves.X_MEDIA_BASE.strip() or self.DEFAULT_MEDIA_BASE).rstrip("/")

    def _headers(self) -> dict:
        token = self.valves.X_ACCESS_TOKEN.strip()
        if not token:
            raise RuntimeError(
                "X_ACCESS_TOKEN vide : renseignez-le dans les Valves de l'outil "
                "(Workspace → Tools → ⚙️ à côté de l'outil)."
            )
        headers = {
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        }
        client_id = self.valves.X_CLIENT_ID.strip()
        if client_id:
            headers["X-Client-Id"] = client_id
        return headers

    # --- OAuth 1.0a (publication de posts et médias) ---
    def _oauth1_configured(self) -> bool:
        v = self.valves
        return all(
            x.strip()
            for x in (
                v.X_API_KEY,
                v.X_API_SECRET,
                v.X_OAUTH1_ACCESS_TOKEN,
                v.X_OAUTH1_ACCESS_SECRET,
            )
        )

    def _oauth1_header(
        self,
        method: str,
        url: str,
        params: Optional[dict] = None,
        nonce: Optional[str] = None,
        timestamp: Optional[str] = None,
    ) -> str:
        """Construit l'en-tête Authorization OAuth 1.0a (HMAC-SHA1). Corps JSON non signé, conformément à la spec."""
        v = self.valves
        enc = lambda x: urllib.parse.quote(str(x), safe="~")
        oauth = {
            "oauth_consumer_key": v.X_API_KEY.strip(),
            "oauth_nonce": nonce or uuid.uuid4().hex,
            "oauth_signature_method": "HMAC-SHA1",
            "oauth_timestamp": timestamp or str(int(time.time())),
            "oauth_token": v.X_OAUTH1_ACCESS_TOKEN.strip(),
            "oauth_version": "1.0",
        }
        signed = {**(params or {}), **oauth}
        pairs = sorted((enc(k), enc(val)) for k, val in signed.items())
        param_str = "&".join(f"{k}={val}" for k, val in pairs)
        base = "&".join([method.upper(), enc(url), enc(param_str)])
        key = f"{enc(v.X_API_SECRET.strip())}&{enc(v.X_OAUTH1_ACCESS_SECRET.strip())}"
        oauth["oauth_signature"] = base64.b64encode(
            hmac.new(key.encode(), base.encode(), hashlib.sha1).digest()
        ).decode()
        return "OAuth " + ", ".join(
            f'{enc(k)}="{enc(val)}"' for k, val in sorted(oauth.items())
        )

    def _auth_headers(
        self, method: str, url: str, params: Optional[dict], auth: str
    ) -> dict:
        if auth == "oauth1":
            if not self._oauth1_configured():
                raise RuntimeError(
                    "Identifiants OAuth 1.0a incomplets : renseignez X_API_KEY, X_API_SECRET, "
                    "X_OAUTH1_ACCESS_TOKEN et X_OAUTH1_ACCESS_SECRET dans les Valves."
                )
            return {
                "Authorization": self._oauth1_header(method, url, params),
                "Content-Type": "application/json",
                "Accept": "application/json",
            }
        return self._headers()

    def _post_auth_mode(self) -> str:
        """OAuth 1.0a si les 4 clés sont renseignées, sinon Bearer user-context (OAuth 2.0)."""
        return "oauth1" if self._oauth1_configured() else "bearer"

    def _validate_event_type(self, event_type: str) -> None:
        if event_type not in self.EVENTS:
            raise ValueError(
                f"event_type inconnu '{event_type}'. Appelez list_event_types pour la liste."
            )

    def _check_expires_at(self, value: str) -> str:
        value = value.strip()
        if not self.RFC3339.match(value):
            raise ValueError(
                "expires_at doit être au format RFC 3339, ex : 2026-12-31T23:59:59Z."
            )
        try:
            dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            raise ValueError("expires_at illisible : vérifiez la date et l'heure.")
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        if dt <= datetime.now(timezone.utc):
            raise ValueError("expires_at est dans le passé.")
        return value

    @staticmethod
    def _status_hint(status: int) -> Optional[str]:
        hints = {
            400: "Requête invalide : vérifiez event_type, filtres et qualifiers.",
            401: "Token invalide ou expiré : vérifiez X_ACCESS_TOKEN dans les Valves.",
            403: "Accès refusé : scope OAuth manquant, événement privé non autorisé par "
            "l'utilisateur, ou palier du compte insuffisant (ex. news.new = Enterprise/Partner).",
            404: "Ressource introuvable : vérifiez l'identifiant.",
            429: "Limite de débit atteinte : réessayez après l'heure indiquée dans rate_limit.reset_at.",
        }
        if status >= 500:
            return "Erreur côté X : réessayez plus tard."
        return hints.get(status)

    @staticmethod
    def _event_notice(event_type: str, meta: Dict[str, Any]) -> Optional[str]:
        if meta["visibility"] == "private":
            scope = f" (scope requis : {meta['scope']})" if meta["scope"] else ""
            return (
                f"{event_type} est un événement privé : il exige un token user-context "
                f"OAuth 2.0 de l'utilisateur suivi{scope}."
            )
        if event_type == "news.new":
            return "news.new est réservé aux comptes Enterprise et Partner."
        return None

    def _call(
        self,
        method: str,
        path: str,
        params: Optional[dict] = None,
        json_body: Optional[dict] = None,
        base: Optional[str] = None,
        auth: str = "bearer",
    ) -> Dict[str, Any]:
        """Exécute la requête HTTP (avec retries sur 429/5xx hors POST) et renvoie un dict."""
        url = f"{base or self._base_url()}{path}"
        retries = max(0, int(self.valves.MAX_RETRIES)) if method != "POST" else 0
        attempt = 0
        while True:
            try:
                resp = requests.request(
                    method,
                    url,
                    headers=self._auth_headers(method, url, params, auth),
                    params=params,
                    json=json_body,
                    timeout=self.valves.REQUEST_TIMEOUT,
                )
            except RuntimeError as e:
                return {"ok": False, "error": str(e)}
            except requests.RequestException as e:
                if attempt < retries:
                    attempt += 1
                    time.sleep(min(2**attempt, 8))
                    continue
                return {"ok": False, "error": f"Erreur réseau : {e}"}

            rate_limit = {}
            remaining = resp.headers.get("x-rate-limit-remaining")
            reset = resp.headers.get("x-rate-limit-reset")
            if remaining is not None:
                rate_limit["remaining"] = remaining
            if reset and reset.isdigit():
                rate_limit["reset_at"] = datetime.fromtimestamp(
                    int(reset), tz=timezone.utc
                ).isoformat()

            if resp.status_code in (429, 500, 502, 503, 504) and attempt < retries:
                wait = min(2 ** (attempt + 1), 8)
                if resp.status_code == 429 and reset and reset.isdigit():
                    wait = int(reset) - int(time.time())
                if 0 <= wait <= 10:
                    attempt += 1
                    time.sleep(wait)
                    continue

            try:
                payload = resp.json()
            except ValueError:
                payload = {"raw": resp.text[:2000]}

            ok = resp.status_code < 400
            result: Dict[str, Any] = {
                "ok": ok,
                "status_code": resp.status_code,
                "data": payload,
            }
            if rate_limit:
                result["rate_limit"] = rate_limit
            if not ok:
                if isinstance(payload, dict) and payload.get("errors"):
                    result["errors"] = payload["errors"]
                hint = self._status_hint(resp.status_code)
                if hint:
                    result["hint"] = hint
            return result

    @staticmethod
    def _extract_items(payload: Any) -> List[dict]:
        """Extrait la liste d'abonnements d'une réponse, quelle que soit sa forme."""
        data = payload.get("data") if isinstance(payload, dict) else payload
        if isinstance(data, list):
            return [x for x in data if isinstance(x, dict)]
        if isinstance(data, dict):
            for key in ("subscriptions", "data"):
                if isinstance(data.get(key), list):
                    return [x for x in data[key] if isinstance(x, dict)]
        return []

    @staticmethod
    def _sub_id(item: dict) -> Optional[str]:
        value = item.get("subscription_id") or item.get("id")
        return str(value) if value is not None else None

    def _fetch_subscriptions(self) -> Dict[str, Any]:
        res = self._call("GET", "/subscriptions")
        if res.get("ok"):
            res["items"] = self._extract_items(res["data"])
        return res

    def _build_subscription_body(
        self,
        event_type: str,
        user_id: Optional[str],
        keyword: Optional[str],
        webhook_id: Optional[str],
        tag: Optional[str],
        expires_at: Optional[str],
        qualifiers: Dict[str, Optional[str]],
    ) -> Dict[str, Any]:
        self._validate_event_type(event_type)
        meta = self.EVENTS[event_type]

        flt: Dict[str, Any] = {}
        if "user_id" in meta["filters"]:
            if not user_id or not user_id.strip().isdigit():
                raise ValueError(
                    f"{event_type} exige user_id (identifiant numérique de l'utilisateur X)."
                )
            flt["user_id"] = user_id.strip()
        if "keyword" in meta["filters"]:
            if not keyword or not keyword.strip():
                raise ValueError(f"{event_type} exige un keyword.")
            flt["keyword"] = keyword.strip()

        clean = {k: v.strip() for k, v in qualifiers.items() if v and v.strip()}
        for key, value in clean.items():
            if key not in meta["qualifiers"]:
                supported = ", ".join(meta["qualifiers"]) or "aucun"
                raise ValueError(
                    f"Le qualifier '{key}' n'est pas supporté par {event_type} (supportés : {supported})."
                )
            allowed = self.QUALIFIER_VALUES.get(key)
            if allowed is not None and value not in allowed:
                raise ValueError(
                    f"Valeur '{value}' invalide pour '{key}' (attendu : {', '.join(allowed)})."
                )
            if key == "post_id" and not value.isdigit():
                raise ValueError("post_id doit être un identifiant numérique de Post.")
        if clean:
            flt["qualifiers"] = clean

        body: Dict[str, Any] = {"event_type": event_type}
        if flt:
            body["filter"] = flt
        if webhook_id:
            body["webhook_id"] = (
                webhook_id.strip()
            )  # absent = livraison par le flux persistant
        if tag:
            body["tag"] = tag
        if expires_at:
            body["expires_at"] = self._check_expires_at(expires_at)
        return body

    # ------------------------------------------------------------------
    # Outils publics — catalogue
    # ------------------------------------------------------------------
    def list_event_types(self, category: Optional[str] = None) -> str:
        """
        Liste les types d'événements supportés, avec leur visibilité (public/privé),
        le scope OAuth requis, les filtres et les qualifiers acceptés.
        :param category: Catégorie à afficher (post, like, follow, subscription, profile, chat, dm_legacy, news, spaces, mute, block, broadcast, oauth). Vide = toutes.
        """
        grouped: Dict[str, Dict[str, Any]] = {}
        for name, meta in self.EVENTS.items():
            if category and meta["category"] != category:
                continue
            grouped.setdefault(meta["category"], {})[name] = {
                k: v for k, v in meta.items() if k != "category" and v not in (None, [])
            }
        if not grouped:
            cats = sorted({m["category"] for m in self.EVENTS.values()})
            return self._dump(
                {
                    "ok": False,
                    "error": f"Catégorie inconnue. Disponibles : {', '.join(cats)}",
                }
            )
        return self._dump(grouped)

    # ------------------------------------------------------------------
    # Outils publics — abonnements
    # ------------------------------------------------------------------
    def create_subscription(
        self,
        event_type: str,
        user_id: Optional[str] = None,
        keyword: Optional[str] = None,
        webhook_id: Optional[str] = None,
        tag: Optional[str] = None,
        expires_at: Optional[str] = None,
        direction: Optional[str] = None,
        conversation_type: Optional[str] = None,
        post_id: Optional[str] = None,
    ) -> str:
        """
        Crée un abonnement d'activité (POST /2/activity/subscriptions).
        Sans webhook_id, les événements sont livrés par le flux persistant (connect_stream).
        Un nouveau POST identique avec un autre expires_at rafraîchit l'expiration.
        :param event_type: Type d'événement (ex : post.create, like.create, news.new). Voir list_event_types.
        :param user_id: ID numérique de l'utilisateur X suivi (requis sauf pour news.new et oauth.revoke).
        :param keyword: Mot-clé (requis uniquement pour news.new).
        :param webhook_id: Webhook de destination (optionnel ; absent = flux persistant).
        :param tag: Étiquette libre pour retrouver l'abonnement.
        :param expires_at: Expiration RFC 3339, ex : 2026-12-31T23:59:59Z.
        :param direction: Qualifier inbound ou outbound (like.create, follow.*, subscriptions.*).
        :param conversation_type: Qualifier direct ou group (chat.received uniquement).
        :param post_id: Qualifier : ID d'un Post précis (like.create uniquement).
        """
        try:
            body = self._build_subscription_body(
                event_type,
                user_id,
                keyword,
                webhook_id,
                tag,
                expires_at,
                {
                    "direction": direction,
                    "conversation_type": conversation_type,
                    "post_id": post_id,
                },
            )
        except ValueError as e:
            return self._dump({"ok": False, "error": str(e)})
        result = self._call("POST", "/subscriptions", json_body=body)
        notice = self._event_notice(event_type, self.EVENTS[event_type])
        if notice:
            result["notice"] = notice
        return self._dump(result)

    def create_subscriptions_bulk(
        self,
        event_types: str,
        user_id: str,
        webhook_id: Optional[str] = None,
        tag: Optional[str] = None,
        expires_at: Optional[str] = None,
    ) -> str:
        """
        Crée plusieurs abonnements d'un coup pour un même utilisateur (25 événements max).
        :param event_types: Types d'événements séparés par des virgules, ex : "post.create,post.delete,profile.update.bio".
        :param user_id: ID numérique de l'utilisateur X suivi.
        :param webhook_id: Webhook de destination (optionnel ; absent = flux persistant).
        :param tag: Étiquette commune aux abonnements.
        :param expires_at: Expiration RFC 3339 commune.
        """
        names = [n.strip() for n in event_types.split(",") if n.strip()]
        if not names:
            return self._dump({"ok": False, "error": "Aucun event_type fourni."})
        if len(names) > 25:
            return self._dump(
                {"ok": False, "error": "25 événements maximum par appel."}
            )

        results = []
        for name in dict.fromkeys(names):  # dédoublonne en gardant l'ordre
            try:
                body = self._build_subscription_body(
                    name, user_id, None, webhook_id, tag, expires_at, {}
                )
            except ValueError as e:
                results.append({"event_type": name, "ok": False, "error": str(e)})
                continue
            res = self._call("POST", "/subscriptions", json_body=body)
            entry = {
                "event_type": name,
                "ok": res.get("ok", False),
                "status_code": res.get("status_code"),
            }
            entry["data" if res.get("ok") else "error"] = (
                res.get("data")
                if res.get("ok")
                else res.get("errors")
                or res.get("error")
                or res.get("hint")
                or res.get("data")
            )
            notice = self._event_notice(name, self.EVENTS[name])
            if notice and not res.get("ok"):
                entry["notice"] = notice
            results.append(entry)

        success = sum(1 for r in results if r["ok"])
        return self._dump(
            {
                "ok": success == len(results),
                "created": success,
                "total": len(results),
                "results": results,
            }
        )

    def list_subscriptions(
        self, event_type: Optional[str] = None, tag: Optional[str] = None
    ) -> str:
        """
        Liste les abonnements actifs (GET /2/activity/subscriptions), avec filtrage optionnel.
        :param event_type: Ne garder que ce type d'événement.
        :param tag: Ne garder que les abonnements portant cette étiquette.
        """
        res = self._fetch_subscriptions()
        if not res.get("ok"):
            res.pop("items", None)
            return self._dump(res)
        items = res["items"]
        if event_type:
            items = [i for i in items if i.get("event_type") == event_type]
        if tag:
            items = [i for i in items if i.get("tag") == tag]
        out = {
            "ok": True,
            "status_code": res["status_code"],
            "count": len(items),
            "subscriptions": items,
        }
        if "rate_limit" in res:
            out["rate_limit"] = res["rate_limit"]
        return self._dump(out)

    def update_subscription(
        self,
        subscription_id: str,
        tag: Optional[str] = None,
        webhook_id: Optional[str] = None,
    ) -> str:
        """
        Met à jour l'étiquette et/ou le webhook d'un abonnement (PUT /2/activity/subscriptions/:id).
        L'expiration ne se change pas ici : utilisez refresh_subscription_expiration.
        :param subscription_id: Identifiant de l'abonnement.
        :param tag: Nouvelle étiquette.
        :param webhook_id: Nouveau webhook de destination.
        """
        body = {}
        if tag is not None:
            body["tag"] = tag
        if webhook_id is not None:
            body["webhook_id"] = webhook_id
        if not body:
            return self._dump(
                {
                    "ok": False,
                    "error": "Rien à mettre à jour : fournissez tag et/ou webhook_id.",
                }
            )
        return self._dump(
            self._call("PUT", f"/subscriptions/{subscription_id}", json_body=body)
        )

    def refresh_subscription_expiration(
        self, subscription_id: str, expires_at: str
    ) -> str:
        """
        Change la date d'expiration d'un abonnement existant en le re-postant à l'identique
        avec un nouvel expires_at (seule méthode prévue par l'API).
        :param subscription_id: Identifiant de l'abonnement.
        :param expires_at: Nouvelle expiration RFC 3339, ex : 2027-01-31T23:59:59Z.
        """
        try:
            new_expiry = self._check_expires_at(expires_at)
        except ValueError as e:
            return self._dump({"ok": False, "error": str(e)})

        res = self._fetch_subscriptions()
        if not res.get("ok"):
            res.pop("items", None)
            return self._dump(res)
        current = next(
            (i for i in res["items"] if self._sub_id(i) == str(subscription_id)), None
        )
        if not current:
            return self._dump(
                {"ok": False, "error": f"Abonnement '{subscription_id}' introuvable."}
            )
        if not current.get("event_type"):
            return self._dump(
                {"ok": False, "error": "Abonnement illisible : event_type manquant."}
            )

        body: Dict[str, Any] = {
            "event_type": current["event_type"],
            "expires_at": new_expiry,
        }
        if current.get("filter"):
            body["filter"] = current["filter"]
        if current.get("webhook_id"):
            body["webhook_id"] = current["webhook_id"]
        if current.get("tag"):
            body["tag"] = current["tag"]
        return self._dump(self._call("POST", "/subscriptions", json_body=body))

    def delete_subscription(self, subscription_id: str) -> str:
        """
        Supprime un abonnement (DELETE /2/activity/subscriptions/:id).
        :param subscription_id: Identifiant de l'abonnement à supprimer.
        """
        return self._dump(self._call("DELETE", f"/subscriptions/{subscription_id}"))

    def delete_subscriptions_by_tag(self, tag: str, confirm: bool = False) -> str:
        """
        Supprime tous les abonnements portant une étiquette. Sans confirm=true, renvoie seulement un aperçu.
        :param tag: Étiquette des abonnements à supprimer.
        :param confirm: Mettre true pour exécuter réellement la suppression.
        """
        res = self._fetch_subscriptions()
        if not res.get("ok"):
            res.pop("items", None)
            return self._dump(res)
        targets = [i for i in res["items"] if i.get("tag") == tag]
        if not targets:
            return self._dump(
                {
                    "ok": True,
                    "deleted": 0,
                    "message": f"Aucun abonnement avec l'étiquette '{tag}'.",
                }
            )
        if not confirm:
            return self._dump(
                {
                    "ok": True,
                    "preview": True,
                    "would_delete": len(targets),
                    "subscriptions": targets,
                    "message": "Aperçu seulement. Relancez avec confirm=true pour supprimer.",
                }
            )
        results = []
        for item in targets:
            sid = self._sub_id(item)
            if not sid:
                results.append(
                    {"ok": False, "error": "identifiant manquant", "subscription": item}
                )
                continue
            r = self._call("DELETE", f"/subscriptions/{sid}")
            results.append(
                {
                    "subscription_id": sid,
                    "ok": r.get("ok", False),
                    "status_code": r.get("status_code"),
                }
            )
        deleted = sum(1 for r in results if r["ok"])
        return self._dump(
            {
                "ok": deleted == len(results),
                "deleted": deleted,
                "total": len(results),
                "results": results,
            }
        )

