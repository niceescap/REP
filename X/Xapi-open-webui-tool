def _e(
    category, visibility="non précisé", scope=None, filters=("user_id",), qualifiers=()
):
    """Fiche descriptive d'un type d'événement."""
    return {
        "category": category,
        "visibility": visibility,  # public | private | non précisé
        "scope": scope,  # scope OAuth 2.0 requis (événements privés)
        "filters": list(filters),
        "qualifiers": list(qualifiers),
    }


