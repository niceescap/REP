    # Outils publics — téléversement de médias (API v2)
    # ------------------------------------------------------------------
    @staticmethod
    def _human_size(n: int) -> str:
        if n >= 1024 * 1024:
            return f"{n / (1024 * 1024):.1f} Mo"
        if n >= 1024:
            return f"{n / 1024:.1f} Ko"
        return f"{n} o"

    @staticmethod
    def _sniff_mime(data: bytes, hint: Optional[str]) -> Optional[str]:
        """Détecte le type MIME par signature binaire (prioritaire), puis depuis un indice (mime ou nom de fichier)."""
        if data.startswith(b"\xff\xd8\xff"):
            return "image/jpeg"
        if data.startswith(b"\x89PNG\r\n\x1a\n"):
            return "image/png"
        if data[:6] in (b"GIF87a", b"GIF89a"):
            return "image/gif"
        if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
            return "image/webp"
        if len(data) >= 12 and data[4:8] == b"ftyp":
            return "video/quicktime" if data[8:12] == b"qt  " else "video/mp4"
        if hint:
            hint = hint.strip()
            head = hint.split(";")[0].strip().lower()
            if Tools.MIME_PATTERN.match(head):
                return head
            by_name, _ = mimetypes.guess_type(hint)
            if by_name:
                return by_name
        return None

    def _resolve_media(self, media_source: str):
        """
        Charge le média depuis une source : chemin de fichier local, URL http(s),
        'base64:…' ou data URI 'data:<mime>;base64,…'.
        Renvoie (octets, indice de type MIME, type de source).
        """
        src = (media_source or "").strip()
        if not src:
            raise ValueError("media_source est vide.")

        if src.startswith("data:"):
            head, sep, payload = src.partition(",")
            if not sep or ";base64" not in head:
                raise ValueError(
                    "data URI non supporté : seul le format base64 est accepté "
                    "(data:<mime>;base64,…)."
                )
            try:
                data = base64.b64decode(re.sub(r"\s+", "", payload), validate=True)
            except (ValueError, TypeError):
                raise ValueError("data URI illisible : contenu base64 invalide.")
            return data, head[5:].split(";")[0].strip() or None, "data_uri"

        if src.startswith("base64:"):
            try:
                data = base64.b64decode(
                    re.sub(r"\s+", "", src[7:]), validate=True
                )
            except (ValueError, TypeError):
                raise ValueError("base64 illisible : contenu invalide.")
            return data, None, "base64"

        if src.startswith("http://") or src.startswith("https://"):
            try:
                resp = requests.get(src, timeout=self.valves.REQUEST_TIMEOUT)
            except requests.RequestException as e:
                raise ValueError(f"Téléchargement impossible : {e}")
            if resp.status_code >= 400:
                raise ValueError(
                    f"Téléchargement impossible : HTTP {resp.status_code} pour {src}."
                )
            ctype = (resp.headers.get("content-type") or "").split(";")[0].strip()
            return resp.content, ctype or None, "url"

        try:
            with open(src, "rb") as f:
                data = f.read()
        except OSError as e:
            raise ValueError(f"Fichier illisible : {e}")
        return data, src, "file"

    def _media_auth_headers(
        self, method: str, url: str, params: Optional[dict], json_body: Optional[dict]
    ) -> dict:
        """
        En-têtes d'authentification pour les endpoints médias.
        OAuth 1.0a : signature des paramètres de requête uniquement
        (le corps multipart/JSON n'est jamais signé, conformément à la spec).
        """
        if self._post_auth_mode() == "oauth1":
            if not self._oauth1_configured():
                raise RuntimeError(
                    "Identifiants OAuth 1.0a incomplets : renseignez X_API_KEY, X_API_SECRET, "
                    "X_OAUTH1_ACCESS_TOKEN et X_OAUTH1_ACCESS_SECRET dans les Valves."
                )
            headers = {
                "Authorization": self._oauth1_header(method, url, params),
                "Accept": "application/json",
            }
        else:
            token = self.valves.X_ACCESS_TOKEN.strip()
            if not token:
                raise RuntimeError(
                    "X_ACCESS_TOKEN vide : renseignez-le dans les Valves de l'outil "
                    "(Workspace → Tools → ⚙️ à côté de l'outil)."
                )
            headers = {
                "Authorization": f"Bearer {token}",
                "Accept": "application/json",
            }
            client_id = self.valves.X_CLIENT_ID.strip()
            if client_id:
                headers["X-Client-Id"] = client_id
        if json_body is not None:
            headers["Content-Type"] = "application/json"
        # En multipart, requests pose lui-même Content-Type avec la frontière : ne pas le forcer.
        return headers

    @staticmethod
    def _media_status_hint(status: int) -> Optional[str]:
        hints = {
            400: "Requête invalide : vérifiez media_category, media_type et total_bytes.",
            401: "Authentification refusée : vérifiez les clés dans les Valves.",
            403: "Accès refusé : scope media.write manquant (OAuth 2.0), application non "
            "autorisée à téléverser, ou compte sans droits sur ce média.",
            404: "Média ou ressource introuvable : vérifiez l'identifiant.",
            413: "Fichier trop volumineux pour la limite de X (voir la limite de la catégorie).",
            429: "Limite de débit atteinte : réessayez plus tard.",
        }
        if status >= 500:
            return "Erreur côté X : réessayez plus tard."
        return hints.get(status)

    def _media_failure_notice(self, result: Dict[str, Any]) -> None:
        if not result.get("ok") and result.get("status_code") in (401, 403):
            result["notice"] = (
                "Téléverser un média exige un contexte utilisateur avec le scope media.write : "
                "soit les 4 clés OAuth 1.0a dans les Valves (X_API_KEY, X_API_SECRET, "
                "X_OAUTH1_ACCESS_TOKEN, X_OAUTH1_ACCESS_SECRET), soit un token OAuth 2.0 "
                "user-context (media.write, tweet.write) dans X_ACCESS_TOKEN. Un token app-only "
                f"ne suffit pas. Mode utilisé : {'OAuth 1.0a' if self._oauth1_configured() else 'Bearer'}."
            )

    def _media_call(
        self,
        method: str,
        path: str,
        params: Optional[dict] = None,
        data: Optional[dict] = None,
        files: Optional[dict] = None,
        json_body: Optional[dict] = None,
    ) -> Dict[str, Any]:
        """Exécute une requête vers l'API Médias (retries sur 429/5xx pour les GET uniquement)."""
        url = f"{self._media_base()}{path}"
        method = method.upper()
        retries = max(0, int(self.valves.MAX_RETRIES)) if method == "GET" else 0
        attempt = 0
        while True:
            try:
                headers = self._media_auth_headers(method, url, params, json_body)
            except RuntimeError as e:
                return {"ok": False, "error": str(e)}
            try:
                resp = requests.request(
                    method,
                    url,
                    headers=headers,
                    params=params,
                    data=data,
                    files=files,
                    json=json_body,
                    timeout=(10, max(int(self.valves.REQUEST_TIMEOUT), 120)),
                )
            except requests.RequestException as e:
                if attempt < retries:
                    attempt += 1
                    time.sleep(min(2**attempt, 8))
                    continue
                return {"ok": False, "error": f"Erreur réseau : {e}"}

            if resp.status_code in (429, 500, 502, 503, 504) and attempt < retries:
                attempt += 1
                time.sleep(min(2**attempt, 8))
                continue

            rate_limit = {}
            remaining = resp.headers.get("x-rate-limit-remaining")
            reset = resp.headers.get("x-rate-limit-reset")
            if remaining is not None:
                rate_limit["remaining"] = remaining
            if reset and reset.isdigit():
                rate_limit["reset_at"] = datetime.fromtimestamp(
                    int(reset), tz=timezone.utc
                ).isoformat()

            try:
                payload = resp.json()
            except ValueError:
                payload = {"raw": resp.text[:2000]}

            ok = resp.status_code < 400
            result: Dict[str, Any] = {
                "ok": ok,
                "status_code": resp.status_code,
                "data": payload,
            }
            if rate_limit:
                result["rate_limit"] = rate_limit
            if not ok:
                if isinstance(payload, dict) and payload.get("errors"):
                    result["errors"] = payload["errors"]
                hint = self._media_status_hint(resp.status_code)
                if hint:
                    result["hint"] = hint
            return result

    def _upload_simple(
        self,
        data: bytes,
        mime_type: str,
        media_category: str,
        additional_owners: Optional[str],
    ) -> Dict[str, Any]:
        """Téléversement simple (one-shot, multipart) pour les petits médias."""
        form: Dict[str, str] = {
            "media_category": media_category,
            "media_type": mime_type,
        }
        if additional_owners:
            form["additional_owners"] = additional_owners
        files = {"media": ("media", data, mime_type)}
        result = self._media_call("POST", "/upload", data=form, files=files)
        if result.get("ok"):
            result["upload_mode"] = "simple"
        return result

    def _upload_chunked(
        self,
        data: bytes,
        mime_type: str,
        media_category: str,
        additional_owners: Optional[str],
    ) -> Dict[str, Any]:
        """Téléversement fragmenté : initialize → append* → finalize, puis attente du traitement si nécessaire."""
        total = len(data)
        init: Dict[str, Any] = {
            "media_type": mime_type,
            "total_bytes": total,
            "media_category": media_category,
        }
        if additional_owners:
            init["additional_owners"] = [
                x.strip() for x in additional_owners.split(",") if x.strip()
            ]
        res = self._media_call("POST", "/upload/initialize", json_body=init)
        if not res.get("ok"):
            res["failed_step"] = "initialize"
            return res

        payload = res.get("data") if isinstance(res.get("data"), dict) else {}
        inner = payload.get("data") if isinstance(payload.get("data"), dict) else {}
        media_id = str(inner.get("id") or "")
        if not media_id:
            return {
                "ok": False,
                "error": "initialize n'a pas renvoyé de media_id lisible.",
                "data": payload,
            }

        chunk = max(256 * 1024, int(self.valves.MEDIA_CHUNK_BYTES))
        index = 0
        for offset in range(0, total, chunk):
            segment = data[offset : offset + chunk]
            r = self._media_call(
                "POST",
                f"/upload/{media_id}/append",
                data={"segment_index": str(index)},
                files={"media": ("segment", segment, "application/octet-stream")},
            )
            if not r.get("ok"):
                r["media_id"] = media_id
                r["failed_step"] = f"append[{index}]"
                return r
            index += 1

        res = self._media_call("POST", f"/upload/{media_id}/finalize")
        if not res.get("ok"):
            res["media_id"] = media_id
            res["failed_step"] = "finalize"
            return res

        payload = res.get("data") if isinstance(res.get("data"), dict) else {}
        info = payload.get("data") if isinstance(payload.get("data"), dict) else {}

        # Attente du traitement serveur (fréquent pour les vidéos, rare pour les images).
        processing = info.get("processing_info")
        deadline = time.time() + max(0, int(self.valves.MEDIA_PROCESSING_WAIT))
        while isinstance(processing, dict) and processing.get("state") in (
            "pending",
            "in_progress",
        ):
            if time.time() >= deadline:
                break
            time.sleep(max(1, int(processing.get("check_after_secs") or 1)))
            st = self._media_call(
                "GET", "/upload", params={"command": "STATUS", "media_id": media_id}
            )
            if not st.get("ok"):
                st["media_id"] = media_id
                st["failed_step"] = "status"
                return st
            st_payload = st.get("data") if isinstance(st.get("data"), dict) else {}
            if isinstance(st_payload.get("data"), dict):
                info = st_payload["data"]
            processing = info.get("processing_info")
            if isinstance(processing, dict) and processing.get("state") == "failed":
                return {
                    "ok": False,
                    "error": "Traitement du média échoué côté X.",
                    "media_id": media_id,
                    "processing_info": processing,
                }

        return {
            "ok": True,
            "status_code": res.get("status_code"),
            "data": {"data": info},
            "media_id": media_id,
            "upload_mode": "chunked",
        }

    def upload_media(
        self,
        media_source: str,
        mime_type: Optional[str] = None,
        media_category: str = "tweet_image",
        alt_text: Optional[str] = None,
        additional_owners: Optional[str] = None,
        confirm: bool = False,
    ) -> str:
        """
        Téléverse un média sur X (POST /2/media/upload) pour l'attacher à un post.
        Renvoie le media_id à passer dans create_post (media_ids). Sans confirm=true,
        renvoie seulement un aperçu (type détecté, taille, requête prévue) et ne téléverse rien.
        :param media_source: Source du média : chemin de fichier local, URL http(s), ou contenu
        encodé (préfixe 'base64:' ou data URI 'data:<mime>;base64,…').
        :param mime_type: Type MIME (ex : image/jpeg). Détecté automatiquement depuis les octets si omis.
        :param media_category: tweet_image, tweet_gif, tweet_video, dm_image, dm_gif ou dm_video (défaut tweet_image).
        :param alt_text: Texte alternatif accessible, 1000 caractères max (optionnel mais recommandé).
        :param additional_owners: IDs numériques d'autres comptes autorisés à utiliser le média, séparés par des virgules.
        :param confirm: Mettre true pour téléverser réellement.
        """
        media_category = (media_category or "tweet_image").strip()
        spec = self.MEDIA_CATEGORIES.get(media_category)
        if not spec:
            return self._dump(
                {
                    "ok": False,
                    "error": f"media_category inconnu '{media_category}'. "
                    f"Valeurs acceptées : {', '.join(self.MEDIA_CATEGORIES)}.",
                }
            )

        alt = (alt_text or "").strip()
        if len(alt) > 1000:
            return self._dump(
                {"ok": False, "error": "alt_text dépasse 1000 caractères."}
            )

        owners = [o.strip() for o in (additional_owners or "").split(",") if o.strip()]
        if any(not o.isdigit() for o in owners):
            return self._dump(
                {
                    "ok": False,
                    "error": "additional_owners doit contenir des IDs numériques "
                    "séparés par des virgules.",
                }
            )
        owners_str = ",".join(owners) or None

        explicit = (mime_type or "").strip().lower() or None
        if explicit:
            explicit = self.MIME_ALIASES.get(explicit, explicit)
            if not self.MIME_PATTERN.match(explicit):
                return self._dump(
                    {
                        "ok": False,
                        "error": f"mime_type invalide '{mime_type}' : attendu un "
                        "type comme image/jpeg.",
                    }
                )

        try:
            data, hint, source_type = self._resolve_media(media_source)
        except ValueError as e:
            return self._dump({"ok": False, "error": str(e)})
        if not data:
            return self._dump({"ok": False, "error": "Média vide (0 octet)."})

        sniffed = self._sniff_mime(data, hint)
        resolved = self.MIME_ALIASES.get(sniffed or explicit or "", sniffed or explicit)
        if not resolved:
            return self._dump(
                {
                    "ok": False,
                    "error": "Type de média indétectable : précisez mime_type.",
                }
            )
        if resolved not in spec["mimes"]:
            return self._dump(
                {
                    "ok": False,
                    "error": f"{resolved} incompatible avec media_category "
                    f"'{media_category}' (attendu : {', '.join(spec['mimes'])}).",
                }
            )
        mime_notice = None
        if explicit and sniffed and explicit != sniffed:
            mime_notice = (
                f"mime_type='{explicit}' ignoré : la signature des octets indique "
                f"'{sniffed}'."
            )

        size = len(data)
        if size > spec["max_bytes"]:
            return self._dump(
                {
                    "ok": False,
                    "error": f"Fichier trop volumineux pour {media_category} : "
                    f"{self._human_size(size)} pour un maximum de "
                    f"{self._human_size(spec['max_bytes'])}.",
                }
            )

        use_chunked = size > 5 * 1024 * 1024 or media_category.endswith(
            ("_gif", "_video")
        )
        chunk = max(256 * 1024, int(self.valves.MEDIA_CHUNK_BYTES))
        segments = (size + chunk - 1) // chunk if use_chunked else 1

        if not confirm:
            out: Dict[str, Any] = {
                "ok": True,
                "preview": True,
                "source_type": source_type,
                "mime_type": resolved,
                "media_category": media_category,
                "size_bytes": size,
                "size_human": self._human_size(size),
                "alt_text_chars": len(alt),
                "plan": {
                    "method": "POST",
                    "endpoint": f"{self._media_base()}/upload",
                    "upload_mode": "fragmenté (chunked)" if use_chunked else "simple",
                    "steps": (
                        "initialize → append × "
                        f"{segments} → finalize → status si traitement"
                        if use_chunked
                        else "upload (multipart)"
                    ),
                    "auth": (
                        "OAuth 1.0a"
                        if self._post_auth_mode() == "oauth1"
                        else "Bearer (OAuth 2.0 user-context)"
                    ),
                },
                "message": "Aperçu seulement. Relancez avec confirm=true pour téléverser.",
            }
            if mime_notice:
                out["notice"] = mime_notice
            return self._dump(out)

        result = (
            self._upload_chunked(data, resolved, media_category, owners_str)
            if use_chunked
            else self._upload_simple(data, resolved, media_category, owners_str)
        )
        if not result.get("ok"):
            self._media_failure_notice(result)
            return self._dump(result)

        payload = result.get("data") if isinstance(result.get("data"), dict) else {}
        inner = payload.get("data") if isinstance(payload.get("data"), dict) else {}
        media_id = str(inner.get("id") or result.get("media_id") or "")
        if not media_id:
            return self._dump(
                {
                    "ok": False,
                    "error": "Téléversement accepté mais media_id illisible dans la réponse.",
                    "data": payload,
                }
            )

        out = {
            "ok": True,
            "status_code": result.get("status_code"),
            "media_id": media_id,
            "media_key": inner.get("media_key"),
            "upload_mode": result.get("upload_mode")
            or ("chunked" if use_chunked else "simple"),
            "mime_type": resolved,
            "media_category": media_category,
            "size_bytes": size,
            "data": payload,
            "hint": (
                f"Média prêt (valable environ 24 h). Passez media_ids='{media_id}' à "
                "create_post, ou appelez set_media_alt_text pour ajouter une description "
                "accessible avant publication."
            ),
        }
        if inner.get("expires_after_secs") is not None:
            out["expires_after_secs"] = inner["expires_after_secs"]
        if mime_notice:
            out["notice"] = mime_notice

        if alt:
            meta = self._media_call(
                "POST",
                "/metadata",
                json_body={
                    "id": media_id,
                    "metadata": {"alt_text": {"text": alt[:1000]}},
                },
            )
            out["alt_text"] = {
                "ok": meta.get("ok", False),
                "status_code": meta.get("status_code"),
            }
            if not meta.get("ok"):
                out["alt_text"]["error"] = (
                    meta.get("errors") or meta.get("error") or meta.get("data")
                )
        return self._dump(out)

    def set_media_alt_text(self, media_id: str, alt_text: str) -> str:
        """
        Ajoute ou remplace le texte alternatif (accessible) d'un média déjà téléversé
        (POST /2/media/metadata). À appeler après upload_media et avant create_post.
        :param media_id: Identifiant numérique du média (champ media_id de la réponse de upload_media).
        :param alt_text: Description accessible, 1000 caractères max.
        """
        media_id = (media_id or "").strip()
        if not media_id.isdigit():
            return self._dump(
                {"ok": False, "error": "media_id doit être un identifiant numérique."}
            )
        alt = (alt_text or "").strip()
        if not alt:
            return self._dump({"ok": False, "error": "alt_text est vide."})
        if len(alt) > 1000:
            return self._dump(
                {"ok": False, "error": "alt_text dépasse 1000 caractères."}
            )
        result = self._media_call(
            "POST",
            "/metadata",
            json_body={"id": media_id, "metadata": {"alt_text": {"text": alt}}},
        )
        self._media_failure_notice(result)
        return self._dump(result)

    # ------------------------------------------------------------------
    # Outils publics — flux temps réel
    # ------------------------------------------------------------------
    @staticmethod
    def _find_event_type(event: dict) -> Optional[str]:
        """Cherche le type d'un événement reçu (racine ou sous l'objet 'data')."""
        if not isinstance(event, dict):
            return None
        for container in (event, event.get("data")):
            if isinstance(container, dict):
                for key in ("event_type", "type"):
                    if isinstance(container.get(key), str):
                        return container[key]
        return None

    def _collect_stream(
        self, duration_seconds: int, max_events: int, event_type: Optional[str]
    ) -> Dict[str, Any]:
        """Lit le flux (bloquant) ; un minuteur ferme la connexion à l'échéance exacte."""
        url = f"{self._base_url()}/stream"
        events: List[dict] = []
        skipped = 0
        started = time.time()
        deadline = started + duration_seconds
        timer = None
        try:
            with requests.get(
                url,
                headers=self._headers(),
                stream=True,
                timeout=(10, duration_seconds + 30),
            ) as resp:
                if resp.status_code != 200:
                    out = {
                        "ok": False,
                        "status_code": resp.status_code,
                        "data": resp.text[:2000],
                    }
                    hint = self._status_hint(resp.status_code)
                    if hint:
                        out["hint"] = hint
                    return out
                timer = threading.Timer(duration_seconds, resp.close)
                timer.daemon = True
                timer.start()
                try:
                    for line in resp.iter_lines(decode_unicode=True):
                        if time.time() >= deadline:
                            break
                        if not line:  # keep-alive
                            continue
                        line = line.strip()
                        if line.startswith("data:"):  # compat SSE
                            line = line[5:].strip()
                        if not line:
                            continue
                        try:
                            event = json.loads(line)
                        except json.JSONDecodeError:
                            event = {"raw": line}
                        if event_type and self._find_event_type(event) != event_type:
                            skipped += 1
                            continue
                        events.append(event)
                        if len(events) >= max_events:
                            break
                except (requests.RequestException, ValueError, OSError):
                    # Fermeture volontaire à l'échéance ou coupure de lecture : fin normale.
                    if time.time() < deadline - 1 and not events:
                        raise
        except RuntimeError as e:
            return {"ok": False, "error": str(e)}
        except requests.RequestException as e:
            return {"ok": False, "error": f"Erreur réseau : {e}"}
        finally:
            if timer:
                timer.cancel()

        out = {
            "ok": True,
            "event_count": len(events),
            "duration_seconds": round(time.time() - started, 1),
            "reached_max_events": len(events) >= max_events,
            "events": events,
        }
        if event_type:
            out["filtered_out"] = skipped
        return out

    async def connect_stream(
        self,
        duration_seconds: int = 60,
        max_events: int = 20,
        event_type: Optional[str] = None,
        __event_emitter__=None,
    ) -> str:
        """
        Se connecte au flux d'activité persistant (GET /2/activity/stream) et collecte les événements reçus.
        Ne reçoit que les événements des abonnements créés SANS webhook_id.
        :param duration_seconds: Durée d'écoute en secondes (1 à la limite des Valves, défaut 60).
        :param max_events: Nombre maximal d'événements à collecter avant de rendre la main (défaut 20).
        :param event_type: Filtre optionnel appliqué côté outil : ne garder que ce type d'événement.
        """

        async def status(description: str, done: bool = False):
            if __event_emitter__:
                await __event_emitter__(
                    {
                        "type": "status",
                        "data": {"description": description, "done": done},
                    }
                )

        if event_type:
            try:
                self._validate_event_type(event_type)
            except ValueError as e:
                return self._dump({"ok": False, "error": str(e)})

        duration_seconds = max(
            1, min(int(duration_seconds), int(self.valves.MAX_STREAM_SECONDS))
        )
        max_events = max(1, min(int(max_events), int(self.valves.MAX_STREAM_EVENTS)))

        await status(f"Écoute du flux X Activity ({duration_seconds} s max)…")
        result = await asyncio.to_thread(
            self._collect_stream, duration_seconds, max_events, event_type
        )
        if result.get("ok"):
            await status(
                f"Flux terminé : {result['event_count']} événement(s) reçu(s).",
                done=True,
            )
        else:
            await status("Échec de la connexion au flux.", done=True)
        return self._dump(result)

    # ------------------------------------------------------------------
    # Helpers standards du template OpenWebUI
    # ------------------------------------------------------------------
    def get_user_name_and_email_and_id(self, __user__: dict = {}) -> str:
        """Get the user name, Email and ID from the user object."""
        result = ""
        if "name" in __user__:
            result += f"User: {__user__['name']}"
        if "id" in __user__:
            result += f" (ID: {__user__['id']})"
        if "email" in __user__:
            result += f" (Email: {__user__['email']})"
        return result or "User: Unknown"

    def get_current_time(self) -> str:
        """Get the current date and time (local and UTC), useful to build expires_at values."""
        now = datetime.now().astimezone()
        utc = now.astimezone(timezone.utc)
        return (
            f"Local: {now.strftime('%A, %B %d, %Y, %I:%M:%S %p')} | "
            f"UTC (RFC 3339): {utc.strftime('%Y-%m-%dT%H:%M:%SZ')}"
        )
